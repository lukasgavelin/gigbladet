{
  "name": "gigbladet",
  "version": "1.0.0",
  "private": true,
  "description": "GigBladet – Det friktionsfria körschemat för musiker och ensembler",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port 5173 --host",
    "dev:server": "node --experimental-strip-types --experimental-sqlite --watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --experimental-strip-types --experimental-sqlite server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/securityAndCleanCode.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
